{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shumo.local/schemas/problem_review.schema.json",
  "title": "Sequential problem paper review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "project_id", "project_config_path",
    "problem_id", "sequence_index", "artifacts", "review", "next_problem_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_config_path": {"$ref": "#/$defs/path"},
    "problem_id": {"$ref": "#/$defs/id"},
    "sequence_index": {"type": "integer", "minimum": 1},
    "previous_review_path": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "authority", "feedback"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "changes_requested", "approved"]},
        "authority": {"enum": ["user", "team"]},
        "feedback": {"type": "array", "items": {"type": "string"}},
        "reviewed_at": {"type": ["string", "null"]}
      }
    },
    "next_problem_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "minLength": 2},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {
          "enum": ["model_spec", "paper_blueprint", "latex_section", "result", "validation_evidence", "other"]
        },
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
